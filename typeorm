#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")" && pwd)"
local_typeorm="$repo_dir/node_modules/.bin/typeorm"

args=()
skip_next=false
for arg in "$@"; do
  if [[ "$skip_next" == true ]]; then
    skip_next=false
    continue
  fi

  case "$arg" in
    -d|--dataSource)
      skip_next=true
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done

exec "$local_typeorm" "${args[@]}"
